INPUT_DIR=/data/input
OUTPUT_DIR=/data/output
SITE=ieeg
# How repeated imports of one mark are collapsed. exact keeps every copy that
# differs, so nothing is lost; first, last and widest each pick one and can
# drop channels the others named.
DUPLICATE_RULE=exact
# Put the description and the source ts_annotation_id in a JSON body instead
# of a plain-text one. Useful for a migration audit trail.
JSON_BODIES=false
# Prepended to every channel id. Ids must be unique across a workflow run.
SOURCE_PREFIX=
